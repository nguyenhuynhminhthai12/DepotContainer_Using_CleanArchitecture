							"mode": "raw",
							"raw": "{\n    \"Email\": \"admin@test.com\",\n    \"FirstName\": \"Admin\",\n    \"LastName\": \"User\",\n    \"Password\": \"Admin123!\"\n}",
							"options": {
								"raw": {
									"language": "json"
