        <mxCell id="e_doline" value="&lt;div style=&quot;text-align: center; font-size: 14px; font-weight: bold; background-color: #c0392b; color: #ffffff; padding: 6px; margin: -10px -10px 8px -10px; border-radius: 4px 4px 0 0;&quot;&gt;DELIVERY_ORDER_LINE&lt;/div&gt;&lt;b&gt;🔑 Id&lt;/b&gt; : uuid [PK]&lt;br/&gt;&lt;b&gt;🔗 DeliveryOrderId&lt;/b&gt; : uuid [FK]&lt;br/&gt;&lt;b&gt;🔗 ContainerTypeId&lt;/b&gt; : uuid [FK]&lt;br/&gt;&lt;b&gt;• RequestedQty&lt;/b&gt; : int&lt;br/&gt;&lt;b&gt;• DeliveredQty&lt;/b&gt; : int" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c0392b;strokeWidth=2;align=left;verticalAlign=top;spacing=10;shadow=1;" vertex="1" parent="1">
