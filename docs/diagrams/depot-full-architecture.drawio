          <mxGeometry x="100" y="180" width="60" height="100" as="geometry" />
        </mxCell>

        <mxCell id="act_yard" value="&lt;b&gt;Yard Planner&lt;/b&gt;" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="100" y="420" width="60" height="100" as="geometry" />
        </mxCell>

        <mxCell id="act_mgr" value="&lt;b&gt;Depot Manager&lt;/b&gt;" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="100" y="640" width="60" height="100" as="geometry" />
        </mxCell>

        <mxCell id="act_ai" value="&lt;b&gt;AI Skill Agent&lt;br/&gt;(Assistant)&lt;/b&gt;" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1360" y="400" width="60" height="100" as="geometry" />
        </mxCell>

        <!-- Group 1: Gate -->
        <mxCell id="uc1" value="Gate-In Container&lt;br/&gt;&lt;i style=&quot;font-size:11px; color:#27ae60;&quot;&gt;(Validate ISO 6346 Modulo-11)&lt;/i&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2980b9;strokeWidth=2;shadow=1;" vertex="1" parent="sys_box">
          <mxGeometry x="60" y="60" width="220" height="70" as="geometry" />
        </mxCell>

        <mxCell id="uc2" value="Gate-Out Container&lt;br/&gt;&lt;i style=&quot;font-size:11px; color:#c0392b;&quot;&gt;(Verify Delivery Order)&lt;/i&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2980b9;strokeWidth=2;shadow=1;" vertex="1" parent="sys_box">
          <mxGeometry x="60" y="160" width="220" height="70" as="geometry" />
        </mxCell>

        <mxCell id="uc3" value="Generate EIR Interchange Receipt" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2980b9;strokeWidth=2;shadow=1;" vertex="1" parent="sys_box">
          <mxGeometry x="400" y="110" width="230" height="60" as="geometry" />
        </mxCell>

        <!-- Group 2: Yard -->
