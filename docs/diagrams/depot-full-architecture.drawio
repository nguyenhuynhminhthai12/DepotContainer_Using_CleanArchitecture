          <mxGeometry x="60" y="490" width="220" height="70" as="geometry" />
        </mxCell>

        <mxCell id="uc8" value="Yard Aging Report&lt;br/&gt;&lt;i style=&quot;font-size:11px; color:#8e44ad;&quot;&gt;(0-10d vs &gt;=10d by Carrier)&lt;/i&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d35400;strokeWidth=2;shadow=1;" vertex="1" parent="sys_box">
          <mxGeometry x="60" y="590" width="220" height="70" as="geometry" />
        </mxCell>

        <mxCell id="uc9" value="Daily Gate In/Out Throughput" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d35400;strokeWidth=2;shadow=1;" vertex="1" parent="sys_box">
          <mxGeometry x="380" y="590" width="230" height="60" as="geometry" />
        </mxCell>

        <!-- AI UC -->
        <mxCell id="uc10" value="&lt;b&gt;Natural Language Query&lt;/b&gt;&lt;br/&gt;&lt;i style=&quot;font-size:11px; color:#8e44ad;&quot;&gt;(&quot;Show MSC containers &gt;10 days&quot;)&lt;/i&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#8e44ad;strokeWidth=2;shadow=1;" vertex="1" parent="sys_box">
          <mxGeometry x="660" y="320" width="230" height="80" as="geometry" />
        </mxCell>

        <!-- Connectors -->
