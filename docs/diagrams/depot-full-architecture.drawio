        <mxCell id="uc5" value="Create / Resize Block Grid" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#27ae60;strokeWidth=2;shadow=1;" vertex="1" parent="sys_box">
          <mxGeometry x="60" y="380" width="220" height="60" as="geometry" />
        </mxCell>

        <mxCell id="uc6" value="Assign &amp; Re-allocate Slot" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#27ae60;strokeWidth=2;shadow=1;" vertex="1" parent="sys_box">
          <mxGeometry x="400" y="330" width="230" height="60" as="geometry" />
        </mxCell>

