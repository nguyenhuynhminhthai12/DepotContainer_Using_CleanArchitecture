        <!-- 9. DELIVERY_ORDER -->
        <mxCell id="e_do" value="&lt;div style=&quot;text-align: center; font-size: 14px; font-weight: bold; background-color: #c0392b; color: #ffffff; padding: 6px; margin: -10px -10px 8px -10px; border-radius: 4px 4px 0 0;&quot;&gt;DELIVERY_ORDER&lt;/div&gt;&lt;b&gt;🔑 Id&lt;/b&gt; : uuid [PK]&lt;br/&gt;&lt;b&gt;• OrderNumber&lt;/b&gt; : varchar(50)&lt;br/&gt;&lt;b&gt;🔗 CustomerId&lt;/b&gt; : uuid [FK]&lt;br/&gt;&lt;b&gt;🔗 LineOperatorId&lt;/b&gt; : uuid [FK]&lt;br/&gt;&lt;b&gt;• ExpiryDate&lt;/b&gt; : timestamptz&lt;br/&gt;&lt;b&gt;• VesselVoyage&lt;/b&gt; : varchar(100)&lt;br/&gt;&lt;b&gt;• IsClosed&lt;/b&gt; : boolean" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c0392b;strokeWidth=2;align=left;verticalAlign=top;spacing=10;shadow=1;" vertex="1" parent="1">
