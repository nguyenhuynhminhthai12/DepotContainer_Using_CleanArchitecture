  <!-- TAB 1: ERD -->
  <diagram id="tab-erd" name="1. Entity-Relationship Diagram (ERD)">
    <mxGraphModel dx="1422" dy="850" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title Header -->
        <mxCell id="erd_title" value="&lt;b style=&quot;font-size: 20px;&quot;&gt;TechSpherex Container Depot - Entity Relationship Diagram (ERD)&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;color: #666666;&quot;&gt;PostgreSQL Schema · Multi-Tenancy · ISO 6346 Modulo-11 · EIR Lifecycles&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="400" y="30" width="800" height="50" as="geometry" />
        </mxCell>

        <!-- 1. DEPOT -->
        <mxCell id="e_depot" value="&lt;div style=&quot;text-align: center; font-size: 14px; font-weight: bold; background-color: #2b579a; color: #ffffff; padding: 6px; margin: -10px -10px 8px -10px; border-radius: 4px 4px 0 0;&quot;&gt;DEPOT&lt;/div&gt;&lt;b&gt;🔑 Id&lt;/b&gt; : uuid [PK]&lt;br/&gt;&lt;b&gt;• Code&lt;/b&gt; : varchar(50)&lt;br/&gt;&lt;b&gt;• Name&lt;/b&gt; : varchar(200)&lt;br/&gt;&lt;b&gt;• Address&lt;/b&gt; : varchar(500)&lt;br/&gt;&lt;b&gt;• TimeZone&lt;/b&gt; : varchar(50)&lt;br/&gt;&lt;b&gt;• IsActive&lt;/b&gt; : boolean&lt;br/&gt;&lt;b&gt;• TenantId&lt;/b&gt; : varchar(64)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2b579a;strokeWidth=2;align=left;verticalAlign=top;spacing=10;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="120" width="220" height="180" as="geometry" />
        </mxCell>

        <!-- 2. BLOCK -->
        <mxCell id="e_block" value="&lt;div style=&quot;text-align: center; font-size: 14px; font-weight: bold; background-color: #2b579a; color: #ffffff; padding: 6px; margin: -10px -10px 8px -10px; border-radius: 4px 4px 0 0;&quot;&gt;BLOCK&lt;/div&gt;&lt;b&gt;🔑 Id&lt;/b&gt; : uuid [PK]&lt;br/&gt;&lt;b&gt;🔗 DepotId&lt;/b&gt; : uuid [FK]&lt;br/&gt;&lt;b&gt;• Code&lt;/b&gt; : varchar(20)&lt;br/&gt;&lt;b&gt;• Name&lt;/b&gt; : varchar(100)&lt;br/&gt;&lt;b&gt;• IsVirtual&lt;/b&gt; : boolean&lt;br/&gt;&lt;b&gt;• MaxBay&lt;/b&gt; : int&lt;br/&gt;&lt;b&gt;• MaxRow&lt;/b&gt; : int&lt;br/&gt;&lt;b&gt;• MaxTier&lt;/b&gt; : int&lt;br/&gt;&lt;b&gt;• DisplayOrder&lt;/b&gt; : int" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2b579a;strokeWidth=2;align=left;verticalAlign=top;spacing=10;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="380" y="120" width="220" height="210" as="geometry" />
        </mxCell>

        <!-- 3. YARD_SLOT -->
        <mxCell id="e_slot" value="&lt;div style=&quot;text-align: center; font-size: 14px; font-weight: bold; background-color: #2b579a; color: #ffffff; padding: 6px; margin: -10px -10px 8px -10px; border-radius: 4px 4px 0 0;&quot;&gt;YARD_SLOT&lt;/div&gt;&lt;b&gt;🔑 Id&lt;/b&gt; : uuid [PK]&lt;br/&gt;&lt;b&gt;🔗 BlockId&lt;/b&gt; : uuid [FK]&lt;br/&gt;&lt;b&gt;• Bay&lt;/b&gt; : int&lt;br/&gt;&lt;b&gt;• Row&lt;/b&gt; : int&lt;br/&gt;&lt;b&gt;• Tier&lt;/b&gt; : int&lt;br/&gt;&lt;b&gt;• IsOccupied&lt;/b&gt; : boolean&lt;br/&gt;&lt;b&gt;🔗 CurrentCntrId&lt;/b&gt; : uuid [FK]&lt;br/&gt;&lt;hr style=&quot;margin: 4px 0;&quot;/&gt;&lt;span style=&quot;font-size: 10px; color: #666;&quot;&gt;Unique: BlockId+Bay+Row+Tier&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2b579a;strokeWidth=2;align=left;verticalAlign=top;spacing=10;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="700" y="120" width="230" height="200" as="geometry" />
        </mxCell>

        <!-- 4. CONTAINER_TYPE -->
        <mxCell id="e_type" value="&lt;div style=&quot;text-align: center; font-size: 14px; font-weight: bold; background-color: #27ae60; color: #ffffff; padding: 6px; margin: -10px -10px 8px -10px; border-radius: 4px 4px 0 0;&quot;&gt;CONTAINER_TYPE&lt;/div&gt;&lt;b&gt;🔑 Id&lt;/b&gt; : uuid [PK]&lt;br/&gt;&lt;b&gt;• Code&lt;/b&gt; : varchar(20) &lt;i&gt;[20GP,40HC]&lt;/i&gt;&lt;br/&gt;&lt;b&gt;• Name&lt;/b&gt; : varchar(100)&lt;br/&gt;&lt;b&gt;• Family&lt;/b&gt; : varchar(50)&lt;br/&gt;&lt;b&gt;• Description&lt;/b&gt; : text" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#27ae60;strokeWidth=2;align=left;verticalAlign=top;spacing=10;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="740" width="240" height="150" as="geometry" />
        </mxCell>

        <!-- 5. CONTAINER -->
        <mxCell id="e_container" value="&lt;div style=&quot;text-align: center; font-size: 14px; font-weight: bold; background-color: #27ae60; color: #ffffff; padding: 6px; margin: -10px -10px 8px -10px; border-radius: 4px 4px 0 0;&quot;&gt;CONTAINER&lt;/div&gt;&lt;b&gt;🔑 Id&lt;/b&gt; : uuid [PK]&lt;br/&gt;&lt;b&gt;• ContainerNumber&lt;/b&gt; : varchar(11)&lt;br/&gt;&amp;nbsp;&amp;nbsp;&lt;span style=&quot;font-size:10px; color:#27ae60;&quot;&gt;[ISO 6346 Modulo-11 VO]&lt;/span&gt;&lt;br/&gt;&lt;b&gt;🔗 ContainerTypeId&lt;/b&gt; : uuid [FK]&lt;br/&gt;&lt;b&gt;• IsoCode&lt;/b&gt; : varchar(10)&lt;br/&gt;&lt;b&gt;• SizeFeet&lt;/b&gt; : int &lt;i&gt;[20 / 40 ft]&lt;/i&gt;&lt;br/&gt;&lt;b&gt;• MaxWeightKg&lt;/b&gt; : decimal&lt;br/&gt;&lt;b&gt;• TareWeightKg&lt;/b&gt; : decimal&lt;br/&gt;&lt;b&gt;• Owner&lt;/b&gt; : varchar(100)&lt;br/&gt;&lt;b&gt;• Condition&lt;/b&gt; : varchar(50)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#27ae60;strokeWidth=2;align=left;verticalAlign=top;spacing=10;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="420" width="240" height="230" as="geometry" />
        </mxCell>

        <!-- 6. CONTAINER_MOVEMENT (EIR) -->
        <mxCell id="e_movement" value="&lt;div style=&quot;text-align: center; font-size: 14px; font-weight: bold; background-color: #d35400; color: #ffffff; padding: 6px; margin: -10px -10px 8px -10px; border-radius: 4px 4px 0 0;&quot;&gt;CONTAINER_MOVEMENT (EIR)&lt;/div&gt;&lt;b&gt;🔑 Id&lt;/b&gt; : uuid [PK]&lt;br/&gt;&lt;b&gt;🔗 ContainerId&lt;/b&gt; : uuid [FK]&lt;br/&gt;&lt;b&gt;🔗 LineOperatorId&lt;/b&gt; : uuid [FK]&lt;br/&gt;&lt;b&gt;🔗 YardSlotId&lt;/b&gt; : uuid [FK null]&lt;br/&gt;&lt;b&gt;🔗 DeliveryOrderId&lt;/b&gt; : uuid [FK null]&lt;br/&gt;&lt;b&gt;• Classification&lt;/b&gt; : varchar(50)&lt;br/&gt;&lt;b&gt;• Status&lt;/b&gt; : varchar(30) &lt;i&gt;[InYard/GateOut]&lt;/i&gt;&lt;br/&gt;&lt;b&gt;• GateInAt&lt;/b&gt; : timestamptz&lt;br/&gt;&lt;b&gt;• GateOutAt&lt;/b&gt; : timestamptz nullable&lt;br/&gt;&lt;b&gt;• VehicleIn / DriverIn&lt;/b&gt; : varchar&lt;br/&gt;&lt;b&gt;• VehicleOut / DriverOut&lt;/b&gt; : varchar" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d35400;strokeWidth=2;align=left;verticalAlign=top;spacing=10;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="420" y="420" width="280" height="250" as="geometry" />
        </mxCell>

        <!-- 7. LINE_OPERATOR -->
        <mxCell id="e_lineop" value="&lt;div style=&quot;text-align: center; font-size: 14px; font-weight: bold; background-color: #8e44ad; color: #ffffff; padding: 6px; margin: -10px -10px 8px -10px; border-radius: 4px 4px 0 0;&quot;&gt;LINE_OPERATOR&lt;/div&gt;&lt;b&gt;🔑 Id&lt;/b&gt; : uuid [PK]&lt;br/&gt;&lt;b&gt;• Code&lt;/b&gt; : varchar(20) &lt;i&gt;[MSK, CMA, ...]&lt;/i&gt;&lt;br/&gt;&lt;b&gt;• Name&lt;/b&gt; : varchar(200)&lt;br/&gt;&lt;b&gt;• Country&lt;/b&gt; : varchar(100)&lt;br/&gt;&lt;b&gt;• IsActive&lt;/b&gt; : boolean" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8e44ad;strokeWidth=2;align=left;verticalAlign=top;spacing=10;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="840" y="420" width="230" height="150" as="geometry" />
        </mxCell>

        <!-- 8. CUSTOMER -->
        <mxCell id="e_cust" value="&lt;div style=&quot;text-align: center; font-size: 14px; font-weight: bold; background-color: #c0392b; color: #ffffff; padding: 6px; margin: -10px -10px 8px -10px; border-radius: 4px 4px 0 0;&quot;&gt;CUSTOMER&lt;/div&gt;&lt;b&gt;🔑 Id&lt;/b&gt; : uuid [PK]&lt;br/&gt;&lt;b&gt;• TaxCode&lt;/b&gt; : varchar(50)&lt;br/&gt;&lt;b&gt;• Name&lt;/b&gt; : varchar(200)&lt;br/&gt;&lt;b&gt;• Email&lt;/b&gt; : varchar(100)&lt;br/&gt;&lt;b&gt;• Phone&lt;/b&gt; : varchar(50)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c0392b;strokeWidth=2;align=left;verticalAlign=top;spacing=10;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1190" y="420" width="220" height="150" as="geometry" />
